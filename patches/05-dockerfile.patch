--- a/Dockerfile
+++ b/Dockerfile
@@ -1,17 +1,31 @@
-FROM python:3.12
+FROM python:3.12-slim
+
+# Don't buffer stdout/err, don't write .pyc into the image layer.
+ENV PYTHONUNBUFFERED=1 \
+    PYTHONDONTWRITEBYTECODE=1
 
 WORKDIR /app
 
+# Install deps first so the layer caches independently of the source.
 COPY requirements.txt .
 RUN pip install --no-cache-dir -r requirements.txt
 
-COPY . .
+COPY auth.py storage.py server.py ./
 
-ENV TICKETDESK_JWKS_URL=http://keycloak:8080/realms/ticketdesk/protocol/openid-connect/certs
-ENV TICKETDESK_ISSUER=http://keycloak:8080/realms/ticketdesk
-ENV TICKETDESK_USER=alice
-ENV TICKETDESK_GROUPS=eng
+# Run as an unprivileged user. /data is a mounted volume owned at deploy time.
+RUN useradd --system --uid 10001 --home-dir /app appuser \
+    && chown -R appuser:appuser /app
+USER appuser
+
+ENV TICKETDESK_TRANSPORT=http \
+    TICKETDESK_DATA=/data \
+    TICKETDESK_LOG_LEVEL=INFO
 
 EXPOSE 8000
 
+HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
+    CMD python -c "import urllib.request,sys; \
+    sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz').status==200 else 1)"
+
+# Identity is NOT baked in - it comes from the verified bearer token at runtime.
 CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
