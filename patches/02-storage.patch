+    def read_attachment(self, ticket_id: str, filename: str) -> str:
+        path = self._attachment_path(ticket_id, filename)
+        size = path.stat().st_size  # FileNotFoundError if it does not exist
+        if size > self.max_attachment_bytes:
+            raise UnreadableAttachment(
+                f"attachment too large: {filename} "
+                f"({size} bytes, limit {self.max_attachment_bytes})"
