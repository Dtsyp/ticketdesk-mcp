 from pathlib import Path
 
+# Ticket ids are opaque handles like "T-1001". Constraining them keeps a hostile
+# id from turning into a path segment that walks out of the data directory.
+_TICKET_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
+
+
+class InvalidName(ValueError):
+    """Ticket id or attachment name failed validation - never a real file."""
+
+
+class UnreadableAttachment(ValueError):
+    """The attachment exists but cannot be served as text (binary or too large)."""
+
+
+def _utcnow() -> str:
+    return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
+
 
