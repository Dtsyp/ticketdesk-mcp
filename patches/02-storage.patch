+    def __init__(self, root: Path, max_attachment_bytes: int = 1 << 20):
+        self.root = Path(root).resolve()
         self.tickets_dir = self.root / "tickets"
         self.attachments_dir = self.root / "attachments"
+        # Attachments end up in tool results and prompts; cap them so one large
+        # file cannot blow up memory or the model context.
+        self.max_attachment_bytes = max_attachment_bytes
+        # Serialises read-modify-write on ticket files within one process. Not a
+        # cross-process lock - a multi-worker deployment needs a real store.
+        self._write_lock = threading.Lock()
+
+    # --- path safety ---
+
+    def _ticket_path(self, ticket_id: str) -> Path:
+        if not _TICKET_ID_RE.match(ticket_id):
+            raise InvalidName(f"invalid ticket id: {ticket_id!r}")
+        return self.tickets_dir / f"{ticket_id}.json"
+
+    def _attachment_path(self, ticket_id: str, filename: str) -> Path:
+        if not _TICKET_ID_RE.match(ticket_id):
+            raise InvalidName(f"invalid ticket id: {ticket_id!r}")
+        if (
+            filename in ("", ".", "..")
+            or "/" in filename
+            or "\\" in filename
+            or ".." in filename
+            or filename != Path(filename).name
+        ):
+            raise InvalidName(f"invalid attachment name: {filename!r}")
+        base = (self.attachments_dir / ticket_id).resolve()
+        path = (base / filename).resolve()
+        if path.parent != base:
+            raise InvalidName(f"attachment path escapes base: {filename!r}")
+        return path
+
