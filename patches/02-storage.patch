+        raw = path.read_bytes()
+        try:
+            return raw.decode("utf-8")
+        except UnicodeDecodeError as e:
+            # Attachments are surfaced as text; refuse binaries loudly rather
+            # than handing back mojibake the way errors="replace" used to.
+            raise UnreadableAttachment(f"attachment is not utf-8 text: {filename}") from e
