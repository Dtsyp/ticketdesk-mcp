@@ -0,0 +1,23 @@
+# Copy to .env for local development. Do NOT commit the real .env.
+
+# Keycloak dev admin (local only).
+KEYCLOAK_ADMIN=admin
+KEYCLOAK_ADMIN_PASSWORD=change-me
+
+# Resource server: where to fetch signing keys and what to trust.
+TICKETDESK_JWKS_URL=http://keycloak:8080/realms/ticketdesk/protocol/openid-connect/certs
+TICKETDESK_ISSUER=http://keycloak:8080/realms/ticketdesk
+# Must match the audience mapper in keycloak/realm-export.json: the value names
+# THIS service (the resource server), not the client that calls it.
+TICKETDESK_AUDIENCE=ticketdesk-mcp
+
+# Largest attachment served as text / pasted into the summary prompt (bytes).
+# TICKETDESK_MAX_ATTACHMENT_BYTES=1048576
+
+# stdio transport (Claude Desktop / IDE) identity. Ignored over HTTP.
+# TICKETDESK_USER=alice
+# TICKETDESK_GROUPS=eng
+# TICKETDESK_ROLES=employee
+# TICKETDESK_SCOPES=tickets:read
+
+# TICKETDESK_LOG_LEVEL=INFO
