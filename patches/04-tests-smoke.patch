+def test_search_applies_acl(store, monkeypatch):
+    monkeypatch.setattr(server, "store", store)
+    # second ticket owned by an hr user, hr-only
+    (store.tickets_dir / "T-2.json").write_text(json.dumps({
+        "id": "T-2", "subject": "vpn payroll", "owner": "carol",
+        "groups": ["hr"], "status": "open", "comments": [],
+    }), encoding="utf-8")
+    _as(ENG_USER)
+    assert [t["id"] for t in server.search_tickets("vpn")] == ["T-1"]
+    _as(HR_USER)
+    assert [t["id"] for t in server.search_tickets("vpn")] == ["T-2"]
+
